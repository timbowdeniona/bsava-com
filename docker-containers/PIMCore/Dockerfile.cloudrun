
# Production Dockerfile for Pimcore on Google Cloud Run
FROM pimcore/pimcore:php8.3-latest

# Install Nginx and Supervisor
RUN apt-get update && apt-get install -y \
    nginx \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Copy Nginx configuration
COPY .docker/nginx.cloudrun.conf /etc/nginx/sites-available/default
RUN rm -f /etc/nginx/sites-enabled/default && ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

# Copy Supervisor configuration
COPY .docker/supervisord.cloudrun.conf /etc/supervisor/conf.d/supervisord.conf

# Set environment variables for production
ENV APP_ENV=prod
ENV PIMCORE_ENVIRONMENT=prod

# Copy application source
COPY --chown=www-data:www-data . /var/www/html

# Install dependencies
# We use --no-dev and optimize-autoloader for production
RUN COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --optimize-autoloader --no-interaction

# Set up permissions
RUN mkdir -p /var/www/html/var /var/www/html/public/var && \
    chown -R www-data:www-data /var/www/html/var /var/www/html/public/var

# Expose port 8080 (Cloud Run default)
EXPOSE 8080

# Use Supervisor to run both PHP-FPM and Nginx
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
